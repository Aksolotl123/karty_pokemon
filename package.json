{
  "name": "karty-pokemon",
  "version": "1.0.0",
  "description": "Skaner i inwentarz kart Pokémon (PWA) z wymianą dubli",
  "scripts": {
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run ocr-assets",
    "dev": "vite --host",
    "prebuild": "npm run ocr-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:e2e": "node scripts/make-test-card.mjs && playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aksolotl123/karty_pokemon.git"
  },
  "bugs": {
    "url": "https://github.com/Aksolotl123/karty_pokemon/issues"
  },
  "homepage": "https://github.com/Aksolotl123/karty_pokemon#readme",
  "dependencies": {
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "preact": "^10.29.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tesseract.js-data/eng": "^1.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module"
}
